# Agent-Accessibility Scanner — environment variables
# Copy this file: cp .env.example .env
# Then fill in your values.

# Flask session secret — REQUIRED in production. The app refuses to start
# without it unless FLASK_ENV=development. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Shopper backend: "mock" (offline, no API key needed) or "anthropic" (real Claude extraction)
SHOPPER=mock

# Anthropic API key — required if SHOPPER=anthropic
ANTHROPIC_API_KEY=

# Model for shopper simulation (default: claude-sonnet-4-6)
# SHOPPER_MODEL=claude-sonnet-4-6

# Rendered DOM: set to "playwright" to enable headless browser fetch
# Requires: pip install playwright && playwright install chromium
# RENDER=playwright

# Shopper runs per check (default: 5 web, 10 CLI)
# SCAN_N=10

# Stripe — for paid report checkout
# STRIPE_SECRET_KEY=
# STRIPE_PRICE_ID=

# Dev mode — set to "true" to enable demo unlock without Stripe (never in production)
# DEV_MODE=false

# Email delivery — auto-send report after payment
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# FROM_EMAIL=

# Web app tuning
# SCAN_RATE_LIMIT=30          # seconds between scans per IP
# SCAN_COUNT_SEED=0           # floor for the public scan counter
# SCANS_PERSISTENT=false      # set true when .scans/ is on a persistent volume

# Browser-agent checks
# BROWSER_ATTEMPTS=3          # attempts per browser flow (majority vote); 0 skips them
# BROWSER_AGENT_MODEL=claude-haiku-4-5-20251001

# Batch scanning (readiness/batch.py)
# BASE_URL=http://localhost:5000

# Private fix recipes (see readiness/fixes.py)
# FIXES_MODULE=
